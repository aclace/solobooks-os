# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it is already covered by .gitignore.
#
# Every value below is OPTIONAL. The app runs with empty/demo state out of
# the box using nothing but `npm install && npm run dev` — these only turn
# on real persistence and AI features once you add your own accounts.

# --- Supabase (optional: enables real data persistence + auth) ---
# Create a free project at https://supabase.com, then find these under
# Project Settings -> API in your own Supabase dashboard.
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- AI provider (optional: enables the AI hooks in lib/ai.ts) ---
# Use whichever provider you prefer. Only one is required.
AI_PROVIDER=none
AI_API_KEY=your_ai_provider_api_key_here
